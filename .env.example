AGENT_MODE=real
LLM_PROVIDER=auto
PORT=3000

# MongoDB Cloud Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cartwise?retryWrites=true&w=majority

# Brevo SMTP Email Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="CartWise Support" <support@cartwise.com>

# Payment Gateway Sandbox Configuration (Razorpay / Stripe / UPI)
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Store UPI Details
NEXT_PUBLIC_STORE_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_STORE_UPI_NAME="Store Name"

# AI API Keys
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Live Mapbox Rider Telemetry & Interactive Satellite Map
# (Optional: If omitted, automatically defaults to high-definition vector CartoDB Dark Matter / OSM tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Upstash Redis Edge Rate Limiting & Distributed Edge Cache
# Free tier: https://console.upstash.com (10,000 commands/day free forever, zero credit card)
# (Optional: If omitted, automatically falls back to internal sliding-window in-memory rate limiting & TTL cache)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Cloudinary Media Storage (Product images, Snap Search, Customer Avatars)
# Free tier: https://cloudinary.com (25 monthly credits, zero credit card)
# (Optional: If omitted, automatically falls back to local /public/uploads directory)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>


